body-global = background-color"#000000" color"#ededed" font-family"'Inter', sans-serif" margin"0" padding"0" overflow-x"hidden" -webkit-font-smoothing"antialiased" scroll-behavior"smooth"

background-glow = position"fixed" top"-20%" left"30%" width"50vw" height"50vw" background"radial-gradient(circle, rgba(255,255,255,0.02) 0%, transparent 60%)" filter"blur(80px)" z-index"-1" pointer-events"none"

navbar = position"fixed" top"0" width"100%" display"flex" justify-content"space-between" align-items"center" padding"16px 40px" background"rgba(0,0,0,0.7)" backdrop-filter"blur(24px)" border-bottom"1px solid rgba(255,255,255,0.05)" z-index"999" box-sizing"border-box"
nav-logo = font-size"18px" font-weight"700" color"#fff" text-decoration"none" letter-spacing"1px" display"flex" align-items"center" gap"12px"
nav-btn = background"#fff" color"#000" padding"8px 20px" border-radius"99px" font-size"14px" font-weight"600" text-decoration"none" transition"transform 0.2s"

docs-layout = display"flex" max-width"1400px" margin"80px auto 0" padding"40px" gap"60px"
sidebar = width"240px" display"flex" flex-direction"column" gap"8px" position"sticky" top"100px" height"max-content" border-right"1px solid rgba(255,255,255,0.05)" padding-right"20px"
sidebar-link = color"#888" text-decoration"none" font-size"14px" font-weight"500" padding"8px 12px" border-radius"8px" transition"all 0.2s"
sidebar-link:hover = color"#fff" background"rgba(255,255,255,0.05)"
sidebar-title = color"#fff" font-size"12px" font-weight"700" text-transform"uppercase" letter-spacing"1px" margin"20px 0 8px 12px" opacity"0.5"

main-content = flex"1" display"flex" flex-direction"column" gap"80px" padding-bottom"100px" min-width"0"

hero-section = padding"60px 0" border-bottom"1px solid rgba(255,255,255,0.05)"
hero-title = font-size"64px" font-weight"800" letter-spacing"-0.04em" line-height"1.1" margin"0 0 24px 0" background"linear-gradient(180deg, #fff 0%, #777 100%)" -webkit-background-clip"text" -webkit-text-fill-color"transparent"
hero-sub = font-size"20px" color"#888" max-width"700px" line-height"1.6" margin"0" font-weight"400"

doc-h2 = font-size"32px" font-weight"700" color"#fff" margin"0 0 24px 0" letter-spacing"-0.02em"
doc-h3 = font-size"20px" font-weight"600" color"#fff" margin"40px 0 16px 0"
doc-p = font-size"16px" color"#a1a1aa" line-height"1.8" margin"0 0 24px 0"
inline-code = background"rgba(255,255,255,0.1)" color"#fff" padding"2px 6px" border-radius"4px" font-family"'JetBrains Mono', monospace" font-size"14px" border"1px solid rgba(255,255,255,0.05)"

bento-card = position"relative" background"rgba(255, 255, 255, 0.02)" border"1px solid rgba(255, 255, 255, 0.05)" border-radius"16px" padding"32px" overflow"hidden" transition"border 0.3s ease" display"flex" flex-direction"column" gap"16px" margin-bottom"24px"
bento-card:hover = border"1px solid rgba(255, 255, 255, 0.15)"
bento-card::before = content"''" position"absolute" top"0" left"0" width"100%" height"100%" background"radial-gradient(600px circle at var(--mouse-x) var(--mouse-y), rgba(255,255,255,0.06), transparent 40%)" pointer-events"none" opacity"0" transition"opacity 0.5s ease"
bento-card:hover::before = opacity"1"

code-block = background"#050505" border"1px solid rgba(255,255,255,0.05)" border-radius"12px" padding"24px" font-family"'JetBrains Mono', monospace" font-size"14px" color"#a1a1aa" line-height"1.7" white-space"pre-wrap" margin-top"16px"
code-hl = color"#fff" font-weight"700"
code-str = color"#888"

grid-2 = display"grid" grid-template-columns"1fr 1fr" gap"20px"
grid-3 = display"grid" grid-template-columns"repeat(auto-fit, minmax(250px, 1fr))" gap"20px"

preview-box = border"1px solid rgba(255,255,255,0.1)" border-radius"12px" padding"40px" background"url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMiIgY3k9IjIiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4wNSkiLz48L3N2Zz4=')" display"flex" justify-content"center" align-items"center" margin-bottom"16px" gap"16px"

btn-ghost = background"transparent" color"#fff" border"1px solid rgba(255,255,255,0.2)" padding"10px 20px" border-radius"8px" font-size"14px" cursor"pointer" transition"all 0.2s"
btn-ghost:hover = background"#fff" color"#000"

table-grid = display"grid" grid-template-columns"200px 1fr" gap"16px" border-bottom"1px solid rgba(255,255,255,0.05)" padding"16px 0"
table-head = color"#fff" font-weight"600" font-size"14px" text-transform"uppercase" letter-spacing"1px"
table-cell = font-family"'JetBrains Mono'" font-size"14px" color"#888"
